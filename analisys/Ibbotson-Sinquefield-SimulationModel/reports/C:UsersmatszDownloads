<span id="cb6-13"><a href="#cb6-13" aria-hidden="true" tabindex="-1"></a>              <span class="op">:</span>rf <span class="op">=&gt;</span> μπ <span class="op">+</span> μr, <span class="op">:</span>rb <span class="op">=&gt;</span> μπ <span class="op">+</span> μr <span class="op">+</span> μtp, <span class="op">:</span>re <span class="op">=&gt;</span> μπ <span class="op">+</span> μr <span class="op">+</span> μerp,</span>
<span id="cb6-14"><a href="#cb6-14" aria-hidden="true" tabindex="-1"></a>              <span class="op">:</span>rb_real <span class="op">=&gt;</span> μr <span class="op">+</span> μtp, <span class="op">:</span>re_real <span class="op">=&gt;</span> μr <span class="op">+</span> μerp)</span>
